rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same development caveat as firestore.rules: writes are not tied to a real login yet.
    match /stories/{storyId}/{fileName} {
      allow read: if true;
      allow write: if request.resource == null
        || (request.resource.size < 2 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'));
    }
  }
}
